{
  "candidate_and_feature_config": {
    "radius": 60.0,
    "k_max": 10,
    "crop_buffer": 1500.0,
    "sample_step": 10.0,
    "ctx_offset": 3,
    "head_win": 2,
    "label_max_dist": 100.0
  },
  "features": [
    "dist",
    "dist_rank",
    "dist_minus_min",
    "dist_ratio",
    "n_cand",
    "head_diff",
    "head_valid",
    "head_rank",
    "speed",
    "dt_prev",
    "arc_len",
    "frac",
    "frac_edge",
    "has_rev",
    "deg_to",
    "ctx_prev_dist",
    "ctx_next_dist",
    "ctx_prev_head",
    "ctx_next_head",
    "ctx_mean_dist",
    "fallback"
  ],
  "models": {
    "logreg": {
      "family": "Linear",
      "params": {
        "C": 1.0,
        "max_iter": 500
      }
    },
    "gnb": {
      "family": "Probabilistic",
      "params": {
        "var_smoothing": 1e-09
      }
    },
    "knn": {
      "family": "Instance-based",
      "params": {
        "n_neighbors": 25,
        "weights": "distance"
      }
    },
    "random_forest": {
      "family": "Ensemble (bagging)",
      "params": {
        "n_estimators": 120,
        "max_depth": 18,
        "min_samples_leaf": 5,
        "max_samples": 0.5,
        "n_jobs": 2,
        "random_state": 42
      }
    },
    "extra_trees": {
      "family": "Ensemble (bagging)",
      "params": {
        "n_estimators": 120,
        "max_depth": 18,
        "min_samples_leaf": 5,
        "n_jobs": 2,
        "random_state": 42
      }
    },
    "hist_gb": {
      "family": "Boosting",
      "params": {
        "max_iter": 300,
        "learning_rate": 0.1,
        "max_leaf_nodes": 31,
        "random_state": 42
      }
    },
    "xgboost": {
      "family": "Boosting",
      "params": {
        "n_estimators": 300,
        "learning_rate": 0.1,
        "max_depth": 6,
        "subsample": 0.8,
        "colsample_bytree": 0.8,
        "tree_method": "hist",
        "n_jobs": 2,
        "random_state": 42,
        "eval_metric": "logloss"
      }
    },
    "lightgbm": {
      "family": "Boosting",
      "params": {
        "n_estimators": 300,
        "learning_rate": 0.1,
        "num_leaves": 31,
        "subsample": 0.8,
        "subsample_freq": 1,
        "colsample_bytree": 0.8,
        "n_jobs": 2,
        "random_state": 42,
        "verbose": -1
      }
    },
    "mlp": {
      "family": "Neural network",
      "params": {
        "hidden_layer_sizes": [
          64,
          32
        ],
        "alpha": 0.0001,
        "learning_rate_init": 0.001,
        "batch_size": 1024,
        "max_iter": 60,
        "early_stopping": true,
        "validation_fraction": 0.1,
        "n_iter_no_change": 6,
        "random_state": 42
      }
    }
  },
  "training": {
    "cv": "GroupKFold(5) by trip",
    "train_obs_stride": 3,
    "knn_obs_stride": 12,
    "labels": "reliable only (aligned dist<=100m)",
    "seed": 42
  }
}